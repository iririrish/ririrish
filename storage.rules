rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Phase 1 stores no files, so everything is denied.
    // Phase 4 will allow project members to read/write projects/{projectId}/images/*
    // by checking membership in the project's Firestore document.
    match /{allPaths=**} { allow read, write: if false; }
  }
}
